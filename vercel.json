{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/login", "dest": "/login.html" },
    { "src": "/register", "dest": "/register.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/menu", "dest": "/menu.html" },
    { "src": "/order", "dest": "/order.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/loyalty", "dest": "/loyalty.html" },
    { "src": "/pricing", "dest": "/pricing.html" },
    { "src": "/sourcing", "dest": "/sourcing.html" },
    { "src": "/blog", "dest": "/blog.html" },
    { "handle": "filesystem" }
  ]
}
