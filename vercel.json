{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/order", "destination": "/order.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/loyalty", "destination": "/loyalty.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/sourcing", "destination": "/sourcing.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog-details", "destination": "/blog-details.html" },
    { "source": "/coming-soon", "destination": "/coming-soon.html" },
    { "source": "/maintenance", "destination": "/maintenance.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ]
}
